# PLACEHOLDER — ne jamais versionner de vraies valeurs.
# À remplacer par un fichier chiffré (SOPS) ou un SealedSecret avant de déployer.
apiVersion: v1
kind: Secret
metadata:
  name: worthfold-secrets
type: Opaque
stringData:
  # L'utilisateur et le mot de passe sont ceux de worthfold-postgres-secrets. Un mot de passe sûr pour une
  # URL : `openssl rand -hex 24`.
  WORTHFOLD_DATABASE_URL: "postgres://worthfold:change_me@worthfold-postgres:5432/worthfold"
  # Facultatif : la clé privée de l'application EnableBanking (contenu du fichier .pem). Sans elle, laisser
  # WORTHFOLD_ENABLEBANKING_APP_ID et WORTHFOLD_ENABLEBANKING_KEY_PATH vides dans le ConfigMap.
  # enablebanking.pem: |
  #   -----BEGIN PRIVATE KEY-----
  #   …
  #   -----END PRIVATE KEY-----
