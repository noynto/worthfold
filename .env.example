# Configuration du compose (copier vers .env, qui est ignoré par Git : `cp .env.example .env`).

# Mot de passe de la base, sans caractère spécial (il entre dans une URL). Génère-le :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Port de l'application sur la machine (127.0.0.1 uniquement). Si tu le changes, l'adresse de retour de la banque change aussi.
# PUBLISHED_PORT=3000
# WORTHFOLD_BANK_REDIRECT_URL=http://localhost:3000/bank/callback
# Derrière un proxy HTTPS seulement (voir docs/tech/deployment.md) : l'adresse publique, sans chemin.
# Elle devient l'hôte accepté, rend les cookies Secure et donne l'adresse de retour de la banque.
# WORTHFOLD_PUBLIC_URL=https://worthfold.example.com
# Avec un proxy devant : 1. Sans cela, tous les visiteurs partagent le même frein des essais de mot de passe.
# WORTHFOLD_PROXY_HOPS=1

# Utilisateur du conteneur de l'application : celui de la machine (`id -u`, `id -g`), pour qu'il lise les secrets en 0600.
# WORTHFOLD_UID=1000
# WORTHFOLD_GID=1000

# Connexion bancaire EnableBanking : décommenter les deux lignes, et mettre la clé dans secrets/enablebanking.pem.
# COMPOSE_FILE=compose.yaml:compose.bank.yaml
# WORTHFOLD_ENABLEBANKING_APP_ID=

# Verbosité des journaux (info, debug, warn).
# RUST_LOG=info
